# HTTP
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# SQLite (relative paths resolve from the project working directory)
DATABASE_PATH=./data/wealthflow.sqlite

# mock is fully functional.
# wealthfolio_addon keeps scheduling in Node and hands explicit delivery to the
# installable Wealthfolio add-on while its browser page is open.
# wealthfolio is fail-closed; wealthfolio_bridge is a legacy external service mode.
ADAPTER_MODE=mock

# Native add-on mode. Generate a random value of at least 24 characters and
# enter the same token in the installed add-on UI. Never commit the real value.
WEALTHFLOW_ADDON_TOKEN=

# Reserved for a future official/bridge Wealthfolio adapter.
# Current code does not use these values and will not send them to the browser.
# Self-hosted Wealthfolio commonly uses a password-only login; put that secret here.
# Do not commit your real .env file.
WEALTHFOLIO_URL=http://127.0.0.1:8080
WEALTHFOLIO_PASSWORD=
# Optional future compatibility fields; leave empty unless your bridge/API requires them.
WEALTHFOLIO_USERNAME=
WEALTHFOLIO_TOKEN=

# Legacy external bridge mode only. A native add-on cannot listen on this port.
WEALTHFOLIO_BRIDGE_URL=http://127.0.0.1:8791
WEALTHFOLIO_BRIDGE_TOKEN=

# Scheduler process settings
SCHEDULER_POLL_MS=15000
EXECUTION_TIMEOUT_MS=10000
LEASE_SECONDS=30
# Maximum BACKFILL occurrences materialized for one schedule in one tick (1-1000).
MATERIALIZE_BATCH_LIMIT=100
